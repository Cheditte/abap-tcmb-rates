{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "files": "/**/*.*",
      "folder": "/.abaplint-deps"
    }
  ],
  "syntax": {
    "version": "v700",
    "errorNamespace": "^(Z|Y|LCL_|LIF_|LTC_|LCX_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true
  }
}
