  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD to_date.`.
  APPEND gv_line TO item-source.
  gv_line = `    " TCMB writes the date as DD.MM.YYYY`.
  APPEND gv_line TO item-source.
  gv_line = `    IF strlen( iv_text ) <> 10`.
  APPEND gv_line TO item-source.
  gv_line = `       OR substring( val = iv_text off = 2 len = 1 ) <> ``.```.
  APPEND gv_line TO item-source.
  gv_line = `       OR substring( val = iv_text off = 5 len = 1 ) <> ``.```.
  APPEND gv_line TO item-source.
  gv_line = `       OR iv_text CN '0123456789.'.`.
  APPEND gv_line TO item-source.
  gv_line = `      parse_error( |Bulletin date "{ iv_text }" is not DD.MM.YYYY| ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    rv_date = substring( val = iv_text off = 6 len = 4 )`.
  APPEND gv_line TO item-source.
  gv_line = `           && substring( val = iv_text off = 3 len = 2 )`.
  APPEND gv_line TO item-source.
  gv_line = `           && substring( val = iv_text off = 0 len = 2 ).`.
  APPEND gv_line TO item-source.
  gv_line = `    IF rv_date CN '0123456789'.`.
  APPEND gv_line TO item-source.
  gv_line = `      parse_error( |Bulletin date "{ iv_text }" is not DD.MM.YYYY| ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_year) = CONV i( rv_date(4) ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_month) = CONV i( rv_date+4(2) ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_day) = CONV i( rv_date+6(2) ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_days) = 31.`.
  APPEND gv_line TO item-source.
  gv_line = `    CASE lv_month.`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN 4 OR 6 OR 9 OR 11.`.
  APPEND gv_line TO item-source.
  gv_line = `        lv_days = 30.`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN 2.`.
  APPEND gv_line TO item-source.
  gv_line = `        lv_days = COND #( WHEN lv_year MOD 400 = 0 OR ( lv_year MOD 4 = 0 AND lv_year MOD 100 <> 0 )`.
