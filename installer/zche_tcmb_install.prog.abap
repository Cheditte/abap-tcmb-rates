  gv_line = `  METHOD validate_client.`.
  APPEND gv_line TO item-source.
  gv_line = `    " CCCORACTIV: blank = manual recording; 1 = automatic; 2 = closed;`.
  APPEND gv_line TO item-source.
  gv_line = `    " 3 = local changes allowed, transports forbidden. Zero is not a value.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF iv_state <> space AND iv_state <> '1' AND iv_state <> '3'.`.
  APPEND gv_line TO item-source.
  gv_line = `      RAISE EXCEPTION TYPE zcx_che_tcmb EXPORTING text = ``Client customizing is closed or has an unk`
  && `nown control value (SCC4).``.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF iv_local = abap_true.`.
  APPEND gv_line TO item-source.
  gv_line = `      IF iv_has_task = abap_true OR iv_state = '1'.`.
  APPEND gv_line TO item-source.
  gv_line = `        RAISE EXCEPTION TYPE zcx_che_tcmb EXPORTING text = ``Local save needs an empty task and a cli`
  && `ent allowing changes without automatic recording.``.`.
  APPEND gv_line TO item-source.
  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    ELSE.`.
  APPEND gv_line TO item-source.
  gv_line = `      IF iv_state = '3'.`.
