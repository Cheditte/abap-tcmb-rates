  APPEND gv_line TO item-source.
  gv_line = `    ENDCASE.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF lv_year = 0 OR lv_month < 1 OR lv_month > 12 OR lv_day < 1 OR lv_day > lv_days.`.
