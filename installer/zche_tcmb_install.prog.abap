  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD parse.`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lo_ixml) = cl_ixml=>create( ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lo_factory) = lo_ixml->create_stream_factory( ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lo_document) = lo_ixml->create_document( ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lo_parser) = lo_ixml->create_parser(`.
  APPEND gv_line TO item-source.
  gv_line = `      stream_factory = lo_factory`.
  APPEND gv_line TO item-source.
  gv_line = `      istream        = lo_factory->create_istream_xstring( iv_xml )`.
  APPEND gv_line TO item-source.
  gv_line = `      document       = lo_document ).`.
  APPEND gv_line TO item-source.
  gv_line = `    IF lo_parser->parse( ) <> 0.`.
  APPEND gv_line TO item-source.
  gv_line = `      parse_error( ``The TCMB answer is not valid XML`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lo_root) = lo_document->get_root_element( ).`.
  APPEND gv_line TO item-source.
  gv_line = `    IF lo_root IS NOT BOUND OR lo_root->get_name( ) <> ``Tarih_Date``.`.
  APPEND gv_line TO item-source.
  gv_line = `      parse_error( ``The TCMB answer is not an exchange rate bulletin`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    rs_bulletin-date   = to_date( lo_root->get_attribute( name = ``Tarih`` ) ).`.
  APPEND gv_line TO item-source.
  gv_line = `    rs_bulletin-number = lo_root->get_attribute( name = ``Bulten_No`` ).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lo_list) = lo_root->get_elements_by_tag_name( name = ``Currency`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DO lo_list->get_length( ) TIMES.`.
  APPEND gv_line TO item-source.
  gv_line = `      DATA(lo_currency) = CAST if_ixml_element( lo_list->get_item( sy-index - 1 ) ).`.
  APPEND gv_line TO item-source.
  gv_line = `      DATA(lv_code) = to_upper( lo_currency->get_attribute( name = ``CurrencyCode`` ) ).`.
  APPEND gv_line TO item-source.
  gv_line = `      IF strlen( lv_code ) <> 3 OR lv_code CN 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.`.
  APPEND gv_line TO item-source.
  gv_line = `        parse_error( |Invalid TCMB currency code "{ lv_code }"| ).`.
  APPEND gv_line TO item-source.
  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `      IF line_exists( rs_bulletin-rates[ code = lv_code ] ).`.
  APPEND gv_line TO item-source.
  gv_line = `        parse_error( |Duplicate TCMB currency code "{ lv_code }"| ).`.
  APPEND gv_line TO item-source.
  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `      APPEND VALUE #(`.
  APPEND gv_line TO item-source.
  gv_line = `        code    = lv_code`.
  APPEND gv_line TO item-source.
  gv_line = `        unit    = to_unit( child_text( io_element = lo_currency iv_name = ``Unit`` ) )`.
  APPEND gv_line TO item-source.
  gv_line = `        fx_buy  = to_value( child_text( io_element = lo_currency iv_name = ``ForexBuying`` ) )`.
  APPEND gv_line TO item-source.
  gv_line = `        fx_sell = to_value( child_text( io_element = lo_currency iv_name = ``ForexSelling`` ) )`.
  APPEND gv_line TO item-source.
  gv_line = `        bn_buy  = to_value( child_text( io_element = lo_currency iv_name = ``BanknoteBuying`` ) )`.
  APPEND gv_line TO item-source.
  gv_line = `        bn_sell = to_value( child_text( io_element = lo_currency iv_name = ``BanknoteSelling`` ) ) )`.
  APPEND gv_line TO item-source.
  gv_line = `        TO rs_bulletin-rates.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDDO.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    IF rs_bulletin-rates IS INITIAL.`.
  APPEND gv_line TO item-source.
  gv_line = `      parse_error( ``The TCMB bulletin contains no currencies`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
