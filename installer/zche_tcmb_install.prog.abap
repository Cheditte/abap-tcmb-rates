  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD zif_che_tcmb_day_loader~load_day.`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(ls_bulletin) = read_bulletin( iv_date ).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_valid_from) = mo_date_rule->valid_from( iv_date ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA lt_known TYPE zif_che_tcmb=>ty_currency_codes.`.
  APPEND gv_line TO item-source.
  gv_line = `    SELECT waers FROM tcurc INTO TABLE @lt_known.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    rt_lines = NEW zcl_che_tcmb_calc( )->build_lines(`.
  APPEND gv_line TO item-source.
  gv_line = `      is_bulletin   = ls_bulletin`.
  APPEND gv_line TO item-source.
  gv_line = `      is_profile    = ms_profile`.
  APPEND gv_line TO item-source.
  gv_line = `      it_mappings   = mt_mappings`.
  APPEND gv_line TO item-source.
  gv_line = `      it_currencies = mt_currencies`.
  APPEND gv_line TO item-source.
  gv_line = `      iv_valid_from = lv_valid_from`.
  APPEND gv_line TO item-source.
  gv_line = `      it_factors    = read_factors( iv_date = lv_valid_from iv_target = target_currency( ) )`.
  APPEND gv_line TO item-source.
  gv_line = `      it_known      = lt_known ).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    IF mo_exit IS BOUND.`.
  APPEND gv_line TO item-source.
  gv_line = `      mo_exit->before_write( EXPORTING is_profile = ms_profile`.
  APPEND gv_line TO item-source.
  gv_line = `                             CHANGING  ct_lines   = rt_lines ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    NEW zcl_che_tcmb_writer( )->write(`.
  APPEND gv_line TO item-source.
  gv_line = `      EXPORTING`.
  APPEND gv_line TO item-source.
  gv_line = `        iv_existing = COND #( WHEN ms_profile-existing_rate IS INITIAL`.
  APPEND gv_line TO item-source.
  gv_line = `                              THEN zif_che_tcmb=>existing-update`.
  APPEND gv_line TO item-source.
  gv_line = `                              ELSE ms_profile-existing_rate )`.
  APPEND gv_line TO item-source.
  gv_line = `        iv_test     = iv_test`.
  APPEND gv_line TO item-source.
  gv_line = `      CHANGING`.
  APPEND gv_line TO item-source.
  gv_line = `        ct_lines    = rt_lines ).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    IF mo_exit IS BOUND.`.
  APPEND gv_line TO item-source.
  gv_line = `      mo_exit->after_write( is_profile = ms_profile it_lines = rt_lines iv_test = iv_test ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD read_bulletin.`.
  APPEND gv_line TO item-source.
  gv_line = `    rs_bulletin = NEW zcl_che_tcmb_parser( )->parse(`.
  APPEND gv_line TO item-source.
  gv_line = `      mo_source->get_bulletin( iv_date = iv_date is_profile = ms_profile ) ).`.
  APPEND gv_line TO item-source.
  gv_line = `    IF rs_bulletin-date <> iv_date.`.
  APPEND gv_line TO item-source.
  gv_line = `      RAISE EXCEPTION TYPE zcx_che_tcmb`.
  APPEND gv_line TO item-source.
  gv_line = `        EXPORTING`.
  APPEND gv_line TO item-source.
  gv_line = `          kind = zcx_che_tcmb=>kinds-parse`.
  APPEND gv_line TO item-source.
  gv_line = `          text = |Asked TCMB for { iv_date DATE = ISO } but got the bulletin of { rs_bulletin-date D`
  && `ATE = ISO }|.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD read_factors.`.
  APPEND gv_line TO item-source.
  gv_line = `    " A ratio is valid from its date on; with inverted dates the newest`.
  APPEND gv_line TO item-source.
  gv_line = `    " ratio that is already valid has the smallest GDATU >= the day`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA lt_rate_types TYPE RANGE OF tcurf-kurst.`.
  APPEND gv_line TO item-source.
  gv_line = `    lt_rate_types = VALUE #( FOR ls_mapping IN mt_mappings`.
  APPEND gv_line TO item-source.
  gv_line = `                             ( sign = 'I' option = 'EQ' low = ls_mapping-rate_type ) ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_gdatu) = zcl_che_tcmb_writer=>inverted_date( iv_date ).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    SELECT kurst, fcurr, tcurr, gdatu, ffact, tfact FROM tcurf`.
  APPEND gv_line TO item-source.
  gv_line = `      WHERE kurst IN @lt_rate_types`.
  APPEND gv_line TO item-source.
  gv_line = `        AND ( fcurr = @iv_target OR tcurr = @iv_target )`.
  APPEND gv_line TO item-source.
  gv_line = `        AND gdatu >= @lv_gdatu`.
  APPEND gv_line TO item-source.
  gv_line = `      ORDER BY kurst, fcurr, tcurr, gdatu`.
  APPEND gv_line TO item-source.
  gv_line = `      INTO TABLE @DATA(lt_tcurf).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    LOOP AT lt_tcurf INTO DATA(ls_tcurf).`.
  APPEND gv_line TO item-source.
  gv_line = `      " Sorted unique table: the first, newest ratio per key wins`.
  APPEND gv_line TO item-source.
  gv_line = `      INSERT VALUE #( kurst = ls_tcurf-kurst`.
  APPEND gv_line TO item-source.
  gv_line = `                      fcurr = ls_tcurf-fcurr`.
  APPEND gv_line TO item-source.
  gv_line = `                      tcurr = ls_tcurf-tcurr`.
  APPEND gv_line TO item-source.
  gv_line = `                      ffact = ls_tcurf-ffact`.
  APPEND gv_line TO item-source.
  gv_line = `                      tfact = ls_tcurf-tfact ) INTO TABLE rt_factors.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDLOOP.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD target_currency.`.
  APPEND gv_line TO item-source.
  gv_line = `    rv_waers = COND #( WHEN ms_profile-target_currency IS INITIAL`.
  APPEND gv_line TO item-source.
  gv_line = `                       THEN zif_che_tcmb=>default_target`.
  APPEND gv_line TO item-source.
  gv_line = `                       ELSE ms_profile-target_currency ).`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
