  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `      IF iv_has_task = abap_false.`.
  APPEND gv_line TO item-source.
  gv_line = `        RAISE EXCEPTION TYPE zcx_che_tcmb EXPORTING text = ``Enter your own modifiable transport task`
  && ` or select Local settings where permitted.``.`.
  APPEND gv_line TO item-source.
  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
