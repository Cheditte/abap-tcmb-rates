  gv_line = `      parse_error( |Unit "{ iv_text }" in the TCMB bulletin must be a positive integer| ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    TRY.`.
  APPEND gv_line TO item-source.
