  APPEND gv_line TO item-source.
  gv_line = `  METHOD sap_currency.`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_list_given) = xsdbool( line_exists( it_currencies[ exclude = abap_false ] ) ).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    READ TABLE it_currencies INTO DATA(ls_currency) WITH KEY tcmb_code = iv_code.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF sy-subrc = 0.`.
  APPEND gv_line TO item-source.
  gv_line = `      IF ls_currency-exclude = abap_false.`.
  APPEND gv_line TO item-source.
  gv_line = `        rv_waers = COND #( WHEN ls_currency-sap_currency IS INITIAL`.
  APPEND gv_line TO item-source.
  gv_line = `                           THEN CONV waers( iv_code )`.
  APPEND gv_line TO item-source.
  gv_line = `                           ELSE ls_currency-sap_currency ).`.
  APPEND gv_line TO item-source.
  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    ELSEIF lv_list_given = abap_false.`.
  APPEND gv_line TO item-source.
  gv_line = `      rv_waers = iv_code.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD pick.`.
  APPEND gv_line TO item-source.
  gv_line = `    rv_value = SWITCH #( iv_source`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN zif_che_tcmb=>source-fx_buy  THEN is_rate-fx_buy`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN zif_che_tcmb=>source-fx_sell THEN is_rate-fx_sell`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN zif_che_tcmb=>source-bn_buy  THEN is_rate-bn_buy`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN zif_che_tcmb=>source-bn_sell THEN is_rate-bn_sell`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN zif_che_tcmb=>source-fx_avg`.
  APPEND gv_line TO item-source.
  gv_line = `        THEN COND #( WHEN is_rate-fx_buy > 0 AND is_rate-fx_sell > 0`.
  APPEND gv_line TO item-source.
  gv_line = `                     THEN ( is_rate-fx_buy + is_rate-fx_sell ) / 2 )`.
  APPEND gv_line TO item-source.
  gv_line = `      WHEN zif_che_tcmb=>source-bn_avg`.
  APPEND gv_line TO item-source.
  gv_line = `        THEN COND #( WHEN is_rate-bn_buy > 0 AND is_rate-bn_sell > 0`.
  APPEND gv_line TO item-source.
  gv_line = `                     THEN ( is_rate-bn_buy + is_rate-bn_sell ) / 2 ) ).`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD add_line.`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(ls_line) = is_line.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    " Both entries use the ratio of the direct pair (foreign -> target):`.
  APPEND gv_line TO item-source.
  gv_line = `    " for an indirect quotation SAP reads the ratio of the reverse pair`.
  APPEND gv_line TO item-source.
  gv_line = `    " (seen on S/4HANA 2023 with CONVERT_TO_LOCAL_CURRENCY)`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_foreign) = COND waers( WHEN ls_line-indirect = abap_true THEN ls_line-to_curr ELSE ls_li`
  && `ne-from_curr ).`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_target) = COND waers( WHEN ls_line-indirect = abap_true THEN ls_line-from_curr ELSE ls_l`
  && `ine-to_curr ).`.
  APPEND gv_line TO item-source.
  gv_line = `    READ TABLE it_factors INTO DATA(ls_factor)`.
  APPEND gv_line TO item-source.
  gv_line = `      WITH TABLE KEY kurst = ls_line-rate_type`.
  APPEND gv_line TO item-source.
  gv_line = `                     fcurr = lv_foreign`.
  APPEND gv_line TO item-source.
  gv_line = `                     tcurr = lv_target.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF sy-subrc <> 0.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-status  = zif_che_tcmb=>status-error.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-message = |No ratio in TCURF for { ls_line-rate_type } {`.
  APPEND gv_line TO item-source.
  gv_line = `                         lv_foreign }/{ lv_target } (maintain it with OBBS)|.`.
  APPEND gv_line TO item-source.
  gv_line = `      APPEND ls_line TO ct_lines.`.
  APPEND gv_line TO item-source.
  gv_line = `      RETURN.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF ls_line-indirect = abap_true.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-from_factor = ls_factor-tfact.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-to_factor   = ls_factor-ffact.`.
  APPEND gv_line TO item-source.
  gv_line = `    ELSE.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-from_factor = ls_factor-ffact.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-to_factor   = ls_factor-tfact.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    " TCMB: UNIT foreign units cost VALUE target units; TCURR quotes the`.
  APPEND gv_line TO item-source.
  gv_line = `    " rate for FFACT foreign units against TFACT target units`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lv_rate) = iv_value * ls_factor-ffact / ( iv_unit * ls_factor-tfact ).`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `    TRY.`.
  APPEND gv_line TO item-source.
  gv_line = `        ls_line-rate = round( val = lv_rate dec = 5 ).`.
  APPEND gv_line TO item-source.
  gv_line = `      CATCH cx_sy_conversion_overflow cx_sy_arithmetic_overflow.`.
  APPEND gv_line TO item-source.
  gv_line = `        ls_line-status  = zif_che_tcmb=>status-error.`.
  APPEND gv_line TO item-source.
  gv_line = `        ls_line-message = |Rate { lv_rate } does not fit TCURR; use a larger ratio in TCURF (OBBS)|.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDTRY.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF ls_line-status IS INITIAL AND ls_line-rate <= 0.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-status  = zif_che_tcmb=>status-error.`.
  APPEND gv_line TO item-source.
  gv_line = `      ls_line-message = |Rate { lv_rate } rounds to zero; use a larger ratio in TCURF (OBBS)|.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    APPEND ls_line TO ct_lines.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
