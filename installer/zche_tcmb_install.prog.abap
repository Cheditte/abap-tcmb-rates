  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD validate_config.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF ms_profile-target_currency IS NOT INITIAL`.
  APPEND gv_line TO item-source.
  gv_line = `       AND ms_profile-target_currency <> zif_che_tcmb=>default_target.`.
  APPEND gv_line TO item-source.
  gv_line = `      config_error( ``TCMB bulletins quote rates in TRY; TARGET_CURRENCY must be empty or TRY`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF ms_profile-existing_rate IS NOT INITIAL`.
  APPEND gv_line TO item-source.
  gv_line = `       AND ms_profile-existing_rate <> zif_che_tcmb=>existing-update`.
  APPEND gv_line TO item-source.
  gv_line = `       AND ms_profile-existing_rate <> zif_che_tcmb=>existing-skip.`.
  APPEND gv_line TO item-source.
  gv_line = `      config_error( ``Unknown EXISTING_RATE policy; use U (update) or S (keep existing)`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF ms_profile-no_bulletin IS NOT INITIAL`.
  APPEND gv_line TO item-source.
  gv_line = `       AND ms_profile-no_bulletin <> zif_che_tcmb=>no_bulletin-log`.
  APPEND gv_line TO item-source.
  gv_line = `       AND ms_profile-no_bulletin <> zif_che_tcmb=>no_bulletin-warning`.
  APPEND gv_line TO item-source.
  gv_line = `       AND ms_profile-no_bulletin <> zif_che_tcmb=>no_bulletin-error.`.
  APPEND gv_line TO item-source.
  gv_line = `      config_error( ``Unknown NO_BULLETIN policy; use I, W or E`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    LOOP AT mt_mappings INTO DATA(ls_mapping).`.
  APPEND gv_line TO item-source.
  gv_line = `      IF ls_mapping-rate_type IS INITIAL.`.
  APPEND gv_line TO item-source.
  gv_line = `        config_error( ``A TCMB mapping has no SAP rate type`` ).`.
  APPEND gv_line TO item-source.
  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `      IF ls_mapping-source <> zif_che_tcmb=>source-fx_buy`.
  APPEND gv_line TO item-source.
  gv_line = `         AND ls_mapping-source <> zif_che_tcmb=>source-fx_sell`.
  APPEND gv_line TO item-source.
  gv_line = `         AND ls_mapping-source <> zif_che_tcmb=>source-bn_buy`.
  APPEND gv_line TO item-source.
  gv_line = `         AND ls_mapping-source <> zif_che_tcmb=>source-bn_sell`.
  APPEND gv_line TO item-source.
  gv_line = `         AND ls_mapping-source <> zif_che_tcmb=>source-fx_avg`.
  APPEND gv_line TO item-source.
  gv_line = `         AND ls_mapping-source <> zif_che_tcmb=>source-bn_avg.`.
  APPEND gv_line TO item-source.
  gv_line = `        config_error( |Unknown TCMB source "{ ls_mapping-source }" in mapping for { ls_mapping-rate_`
  && `type }| ).`.
  APPEND gv_line TO item-source.
  gv_line = `      ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDLOOP.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `ENDCLASS.`.
