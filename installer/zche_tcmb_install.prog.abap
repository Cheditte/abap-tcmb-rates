  CLEAR item.
  item-kind = 'INTF'.
  item-name = 'ZIF_CHE_TCMB'.
  item-xml = `<asx:abap xmlns:asx="http://www.sap.com/abapxml" version="1.0"><asx:values><VSEOINTERF><CLSNAME>ZIF_`
  && `CHE_TCMB</CLSNAME><LANGU>E</LANGU><DESCRIPT>TCMB exchange rates: shared types and constants</DESCRIP`
  && `T><EXPOSURE>2</EXPOSURE><STATE>1</STATE><UNICODE>X</UNICODE></VSEOINTERF></asx:values></asx:abap>`.
  gv_line = `"! <p class="shorttext synchronized">TCMB exchange rates: shared types and constants</p>`.
  APPEND gv_line TO item-source.
  gv_line = `"! abap-tcmb-rates, https://github.com/Cheditte/abap-tcmb-rates (MIT License)`.
  APPEND gv_line TO item-source.
  gv_line = `INTERFACE zif_che_tcmb PUBLIC.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS version TYPE string VALUE ``0.1.0``.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  "! Address of the TCMB bulletins; one day is &lt;url&gt;/YYYYMM/DDMMYYYY.xml`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS default_url TYPE string VALUE ``https://www.tcmb.gov.tr/kurlar``.`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS default_target TYPE waers VALUE 'TRY'.`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS default_source_class TYPE seoclsname VALUE 'ZCL_CHE_TCMB_SOURCE_HTTP'.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " TCMB rates that can be mapped to an SAP rate type (domain ZCHE_TCMB_SOURCE)`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF source,`.
  APPEND gv_line TO item-source.
  gv_line = `      fx_buy  TYPE zche_tcmb_source VALUE 'FX_BUY',`.
  APPEND gv_line TO item-source.
  gv_line = `      fx_sell TYPE zche_tcmb_source VALUE 'FX_SELL',`.
  APPEND gv_line TO item-source.
  gv_line = `      bn_buy  TYPE zche_tcmb_source VALUE 'BN_BUY',`.
  APPEND gv_line TO item-source.
  gv_line = `      bn_sell TYPE zche_tcmb_source VALUE 'BN_SELL',`.
  APPEND gv_line TO item-source.
  gv_line = `      fx_avg  TYPE zche_tcmb_source VALUE 'FX_AVG',`.
  APPEND gv_line TO item-source.
  gv_line = `      bn_avg  TYPE zche_tcmb_source VALUE 'BN_AVG',`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF source.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " Which day a bulletin is written for (domain ZCHE_TCMB_DATE_RULE)`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF date_rule,`.
  APPEND gv_line TO item-source.
  gv_line = `      same_day     TYPE zche_tcmb_date_rule VALUE 'SAME_DAY',`.
  APPEND gv_line TO item-source.
  gv_line = `      next_day     TYPE zche_tcmb_date_rule VALUE 'NEXT_DAY',`.
  APPEND gv_line TO item-source.
  gv_line = `      next_workday TYPE zche_tcmb_date_rule VALUE 'NEXT_WORKDAY',`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF date_rule.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " What to do when TCURR already has a rate for that day`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF existing,`.
  APPEND gv_line TO item-source.
  gv_line = `      skip   TYPE zche_tcmb_existing VALUE 'S',`.
  APPEND gv_line TO item-source.
  gv_line = `      update TYPE zche_tcmb_existing VALUE 'U',`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF existing.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " What a day without a bulletin means for the run`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF no_bulletin,`.
  APPEND gv_line TO item-source.
  gv_line = `      log     TYPE zche_tcmb_nodata VALUE 'I',`.
  APPEND gv_line TO item-source.
  gv_line = `      warning TYPE zche_tcmb_nodata VALUE 'W',`.
  APPEND gv_line TO item-source.
  gv_line = `      error   TYPE zche_tcmb_nodata VALUE 'E',`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF no_bulletin.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  TYPES ty_status TYPE c LENGTH 12.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " Result of one line`.
  APPEND gv_line TO item-source.
  gv_line = `  CONSTANTS:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF status,`.
  APPEND gv_line TO item-source.
  gv_line = `      new         TYPE ty_status VALUE 'NEW',`.
  APPEND gv_line TO item-source.
  gv_line = `      updated     TYPE ty_status VALUE 'UPDATED',`.
  APPEND gv_line TO item-source.
  gv_line = `      unchanged   TYPE ty_status VALUE 'UNCHANGED',`.
  APPEND gv_line TO item-source.
  gv_line = `      skipped     TYPE ty_status VALUE 'SKIPPED',`.
  APPEND gv_line TO item-source.
  gv_line = `      no_bulletin TYPE ty_status VALUE 'NO_BULLETIN',`.
  APPEND gv_line TO item-source.
  gv_line = `      error       TYPE ty_status VALUE 'ERROR',`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF status.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  TYPES ty_value TYPE decfloat34.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " One currency of a bulletin; an initial value means TCMB gave none`.
  APPEND gv_line TO item-source.
  gv_line = `  TYPES:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF ty_rate,`.
  APPEND gv_line TO item-source.
  gv_line = `      code    TYPE zche_tcmb_code,`.
  APPEND gv_line TO item-source.
  gv_line = `      unit    TYPE i,`.
  APPEND gv_line TO item-source.
  gv_line = `      fx_buy  TYPE ty_value,`.
  APPEND gv_line TO item-source.
  gv_line = `      fx_sell TYPE ty_value,`.
  APPEND gv_line TO item-source.
  gv_line = `      bn_buy  TYPE ty_value,`.
  APPEND gv_line TO item-source.
  gv_line = `      bn_sell TYPE ty_value,`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF ty_rate,`.
  APPEND gv_line TO item-source.
  gv_line = `    ty_rates TYPE STANDARD TABLE OF ty_rate WITH DEFAULT KEY,`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF ty_bulletin,`.
  APPEND gv_line TO item-source.
  gv_line = `      date   TYPE d,`.
  APPEND gv_line TO item-source.
  gv_line = `      number TYPE string,`.
  APPEND gv_line TO item-source.
  gv_line = `      rates  TYPE ty_rates,`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF ty_bulletin.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " One TCURR entry and what happened to it.`.
  APPEND gv_line TO item-source.
  gv_line = `  " RATE is always positive; INDIRECT marks an entry from the target`.
  APPEND gv_line TO item-source.
  gv_line = `  " currency to the foreign currency, which TCURR stores with a minus sign.`.
  APPEND gv_line TO item-source.
  gv_line = `  TYPES:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF ty_line,`.
  APPEND gv_line TO item-source.
  gv_line = `      bulletin_date TYPE d,`.
  APPEND gv_line TO item-source.
  gv_line = `      tcmb_code     TYPE zche_tcmb_code,`.
  APPEND gv_line TO item-source.
  gv_line = `      source        TYPE zche_tcmb_source,`.
  APPEND gv_line TO item-source.
  gv_line = `      rate_type     TYPE tcurr-kurst,`.
  APPEND gv_line TO item-source.
  gv_line = `      from_curr     TYPE tcurr-fcurr,`.
  APPEND gv_line TO item-source.
  gv_line = `      to_curr       TYPE tcurr-tcurr,`.
  APPEND gv_line TO item-source.
  gv_line = `      valid_from    TYPE d,`.
  APPEND gv_line TO item-source.
  gv_line = `      rate          TYPE tcurr-ukurs,`.
  APPEND gv_line TO item-source.
  gv_line = `      from_factor   TYPE tcurr-ffact,`.
  APPEND gv_line TO item-source.
  gv_line = `      to_factor     TYPE tcurr-tfact,`.
  APPEND gv_line TO item-source.
  gv_line = `      indirect      TYPE abap_bool,`.
  APPEND gv_line TO item-source.
  gv_line = `      status        TYPE ty_status,`.
  APPEND gv_line TO item-source.
  gv_line = `      message       TYPE string,`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF ty_line,`.
  APPEND gv_line TO item-source.
  gv_line = `    ty_lines TYPE STANDARD TABLE OF ty_line WITH DEFAULT KEY.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  " TCURF ratio valid on the day of the entry`.
  APPEND gv_line TO item-source.
  gv_line = `  TYPES:`.
  APPEND gv_line TO item-source.
  gv_line = `    BEGIN OF ty_factor,`.
  APPEND gv_line TO item-source.
  gv_line = `      kurst TYPE tcurf-kurst,`.
  APPEND gv_line TO item-source.
  gv_line = `      fcurr TYPE tcurf-fcurr,`.
  APPEND gv_line TO item-source.
  gv_line = `      tcurr TYPE tcurf-tcurr,`.
  APPEND gv_line TO item-source.
  gv_line = `      ffact TYPE tcurf-ffact,`.
  APPEND gv_line TO item-source.
  gv_line = `      tfact TYPE tcurf-tfact,`.
  APPEND gv_line TO item-source.
  gv_line = `    END OF ty_factor,`.
  APPEND gv_line TO item-source.
  gv_line = `    ty_factors        TYPE SORTED TABLE OF ty_factor WITH UNIQUE KEY kurst fcurr tcurr,`.
  APPEND gv_line TO item-source.
  gv_line = `    ty_currency_codes TYPE SORTED TABLE OF waers WITH UNIQUE KEY table_line.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  TYPES:`.
  APPEND gv_line TO item-source.
  gv_line = `    ty_profile    TYPE zche_tcmb_prof,`.
  APPEND gv_line TO item-source.
  gv_line = `    ty_mappings   TYPE STANDARD TABLE OF zche_tcmb_map WITH DEFAULT KEY,`.
  APPEND gv_line TO item-source.
  gv_line = `    ty_currencies TYPE STANDARD TABLE OF zche_tcmb_curr WITH DEFAULT KEY.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `ENDINTERFACE.`.
  APPEND gv_line TO item-source.
  APPEND item TO gt_items.
