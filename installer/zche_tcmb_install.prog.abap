  gv_line = `        RAISE EXCEPTION TYPE zcx_che_tcmb`.
  APPEND gv_line TO item-source.
  gv_line = `          EXPORTING`.
  APPEND gv_line TO item-source.
  gv_line = `            kind     = zcx_che_tcmb=>kinds-config`.
  APPEND gv_line TO item-source.
  gv_line = `            text     = |Class { iv_class } cannot be created: { lx_create->get_text( ) }|`.
  APPEND gv_line TO item-source.
  gv_line = `            previous = lx_create.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDTRY.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
