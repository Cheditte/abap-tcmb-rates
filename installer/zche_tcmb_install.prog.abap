  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD is_weekday.`.
  APPEND gv_line TO item-source.
  gv_line = `    rv_bool = zcl_che_tcmb_runner=>is_weekday( iv_date ).`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
