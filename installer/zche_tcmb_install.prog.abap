  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD child_text.`.
  APPEND gv_line TO item-source.
  gv_line = `    DATA(lo_child) = io_element->find_from_name( name = iv_name ).`.
  APPEND gv_line TO item-source.
  gv_line = `    IF lo_child IS BOUND.`.
  APPEND gv_line TO item-source.
  gv_line = `      rv_text = condense( lo_child->get_value( ) ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD to_value.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF iv_text IS INITIAL.`.
  APPEND gv_line TO item-source.
  gv_line = `      RETURN.`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    FIND REGEX '^[0-9]+([.][0-9]+)?$' IN iv_text.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF sy-subrc <> 0.`.
  APPEND gv_line TO item-source.
  gv_line = `      parse_error( |"{ iv_text }" in the TCMB bulletin is not a positive decimal number| ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `    TRY.`.
  APPEND gv_line TO item-source.
  gv_line = `        rv_value = iv_text.`.
  APPEND gv_line TO item-source.
  gv_line = `      CATCH cx_sy_conversion_error.`.
  APPEND gv_line TO item-source.
  gv_line = `        parse_error( |"{ iv_text }" in the TCMB bulletin is not a number| ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDTRY.`.
  APPEND gv_line TO item-source.
  gv_line = `    IF rv_value <= 0.`.
  APPEND gv_line TO item-source.
  gv_line = `      parse_error( |"{ iv_text }" in the TCMB bulletin is not positive| ).`.
  APPEND gv_line TO item-source.
  gv_line = `    ENDIF.`.
  APPEND gv_line TO item-source.
  gv_line = `  ENDMETHOD.`.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = ``.
  APPEND gv_line TO item-source.
  gv_line = `  METHOD to_unit.`.
